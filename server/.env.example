# Server
NODE_ENV=development
PORT=5001

# MongoDB — local for development, Atlas for production
MONGODB_URI=mongodb://127.0.0.1:27017/splitmate

# Auth — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Demo login for the seven seeded users.
# MUST be false (or removed) in production.
ALLOW_DEMO_LOGIN=true
DEMO_PASSWORD=splitmate123

# Uploads
UPLOAD_DIR=uploads

# Automatic capture from forwarded bank emails.
# Both values are required before the forwarding address is offered in Settings.
# Point your email provider's inbound webhook at /api/inbound/email.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
